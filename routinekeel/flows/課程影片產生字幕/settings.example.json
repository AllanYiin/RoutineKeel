{
  "model": "whisper-large-v3",
  "profile": "auto",
  "options": {
    "language": "zh",
    "traditional_chinese": true,
    "device": "auto",
    "allow_cpu_fallback": false,
    "audio_preprocessing": "standard",
    "glossary": [],
    "llm": {
      "enabled": false,
      "max_calls": 0,
      "max_segments": 20,
      "max_total_chars": 3000,
      "context_chars": 60
    },
    "max_line_chars": 30,
    "max_cue_seconds": 12,
    "max_cps": 15,
    "min_cue_seconds": 0.5,
    "initial_prompt": "繁體中文",
    "initial_prompt_enabled": true,
    "vad_threshold": 0.3,
    "vad_min_speech_ms": 250,
    "vad_min_silence_ms": 2200,
    "vad_skip_silence_seconds": 3.0
  }
}
